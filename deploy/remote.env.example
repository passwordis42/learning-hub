# Copy into the host secret store. Do not commit real values.
# Remote mode stays off until every value below is set. The default server still binds 127.0.0.1.
HUB_EXPOSURE=remote
HUB_TRUST_PROXY=1
HUB_PUBLIC_ORIGIN=https://learn.example
HUB_ALLOWED_HOSTS=learn.example
HUB_ADMIN_TOKEN=replace-with-a-host-secret-of-at-least-32-characters
# Leave unset to keep the Node process on 127.0.0.1 behind the HTTPS proxy.
# HUB_BIND=127.0.0.1
# ASSISTANT_CONFIG_PATH=/var/lib/learning-hub/assistant-config.json
