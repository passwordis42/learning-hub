# Copy to .env for local use. Enable only the services you plan to call.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus

# The API key must match the selected Model Studio region.
# Regions: beijing, singapore, hongkong, virginia, tokyo.
QWEN_REGION=beijing
# Optional for legacy endpoints in China and Singapore; required for Virginia and Tokyo.
QWEN_WORKSPACE_ID=

PORT=4173
# Leave empty for local use. Optional exact site origin for testing a hosted copy.
TRUSTED_SITE_ORIGIN=
