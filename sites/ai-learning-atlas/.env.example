# Copy to .env and fill only the providers you use.
# Use a text model name available in your provider account.
OPENAI_API_KEY=
OPENAI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional for credentials scoped to multiple workspaces.
ANTHROPIC_WORKSPACE_ID=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

DASHSCOPE_API_KEY=
QWEN_MODEL=
# China (Beijing) defaults to the legacy host if no workspace is specified.
# Regions: cn-beijing, ap-southeast-1, us-east-1, cn-hongkong, ap-northeast-1.
DASHSCOPE_REGION=cn-beijing
DASHSCOPE_WORKSPACE_ID=

TUTOR_HOST=127.0.0.1
TUTOR_PORT=8787
# Browser origins, comma separated, with no paths or trailing slash.
# Example: https://your-name.github.io
TUTOR_ALLOWED_ORIGINS=
# Required for external origins or a non-loopback listener. Use a separate
# randomly generated token of at least 32 characters, not a provider key.
TUTOR_ACCESS_TOKEN=
